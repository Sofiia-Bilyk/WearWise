{
  "name": "wearwise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "python build.py",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.ts",
    "test:components": "tsx --tsconfig tests/components/tsconfig.json --test --test-concurrency=1 tests/components/*.test.tsx"
  },
  "dependencies": {
    "heic2any": "^0.0.4",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
